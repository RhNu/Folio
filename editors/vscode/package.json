{
  "name": "folio-vscode",
  "displayName": "Folio",
  "description": "Papyrus language support powered by the Folio language server",
  "version": "0.1.0",
  "publisher": "folio-local",
  "private": true,
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "papyrus",
        "aliases": [
          "Papyrus"
        ],
        "extensions": [
          ".psc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/papyrus-psc.svg",
          "dark": "./icons/papyrus-psc.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "papyrus",
        "scopeName": "source.papyrus",
        "path": "./syntaxes/papyrus.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "folio.restartServer",
        "title": "Folio: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Folio",
      "properties": {
        "folio.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the Folio executable or its directory. Folio is resolved from this setting, then PATH; the repository's target/debug build is used only in extension development."
        },
        "folio.server.manifestPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional folio.toml path, absolute or relative to the open workspace folder."
        },
        "folio.server.logFilter": {
          "type": "string",
          "default": "info",
          "scope": "resource",
          "description": "Rust tracing filter passed to folio lsp; logs are written to stderr."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "6.0.2"
  }
}