{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Folio: Debug VS Code extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}/fixtures/editor-project"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/out/**/*.js"],
      "preLaunchTask": "Folio: Build VS Code debug session"
    },
    {
      "name": "Folio: Attach to LSP process",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickMyProcess}"
    }
  ]
}
